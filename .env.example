# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Both values are public (they ship to the browser); Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: the public site address, used in email and Google sign-in links.
# Leave empty locally; set to https://eaudefragrances.com in production.
NEXT_PUBLIC_SITE_URL=
